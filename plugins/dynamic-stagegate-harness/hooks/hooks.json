{
  "description": "dynamic-stagegate-harness: .gate/config.toml이 있는 프로젝트에서만 상태 기계 검사를 건다",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/run.py", "session"], "timeout": 30}
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/run.py", "prompt"], "timeout": 30}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/run.py", "guard"], "timeout": 30}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python", "args": ["-X", "utf8", "${CLAUDE_PLUGIN_ROOT}/hooks/run.py", "stop"], "timeout": 60}
        ]
      }
    ]
  }
}
